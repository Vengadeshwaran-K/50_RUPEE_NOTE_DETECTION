# Copy to .env (or set these in your shell) before starting the backend.

RUPEEVISION_MODEL_PATH=models/model.onnx
RUPEEVISION_FRONTEND_DIR=frontend

RUPEEVISION_CONF=0.6
RUPEEVISION_IOU=0.45

# auto | onnxruntime | opencv
RUPEEVISION_BACKEND=auto
# 0 = let the runtime decide
RUPEEVISION_THREADS=0
RUPEEVISION_CUDA=false
RUPEEVISION_MAX_DETECTIONS=300
RUPEEVISION_WARMUP=true
RUPEEVISION_JPEG_QUALITY=85

RUPEEVISION_MAX_UPLOAD_BYTES=10485760
RUPEEVISION_MAX_IMAGE_SIDE=8000

RUPEEVISION_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
